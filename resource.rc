/*
 * resource.rc - Resource file for SerialEcho
 *
 * Defines menu structure, dialog templates,
 * application icon, manifest, and toolbar bitmaps.
 */

#include <windows.h>
#include "resource.h"

/* Application icon */
IDI_APP ICON "app.ico"

/* Application manifest for Common Controls v6 and DPI awareness */
1 RT_MANIFEST "res1.xml"

/* Toolbar bitmaps */
IDB_TOOLBAR     BITMAP "toolbar.bmp"

/* Main menu bar */
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Serial"
    BEGIN
        MENUITEM "&Connect", IDM_CONNECT
        MENUITEM "&Disconnect", IDM_DISCONNECT
    END
    POPUP "&Log"
    BEGIN
        MENUITEM "&Clear", IDM_LOG_CLEAR
        MENUITEM "Save &as...", IDM_LOG_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "&Font...", IDM_LOG_FONT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About", IDM_ABOUT
    END
END

/* Port selection dialog template */
IDD_PORT_SELECT DIALOGEX 0, 0, 280, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Port"
FONT 9, "Microsoft YaHei UI"
BEGIN
    COMBOBOX        IDC_PORT_COMBO, 50, 10, 220, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Port:", -1, 10, 13, 35, 8
    LTEXT           "Baud Rate: 115200 (Fixed)", -1, 10, 35, 260, 8
    LTEXT           "Data: 8   Parity: None   Stop: 1", -1, 10, 50, 260, 8
    DEFPUSHBUTTON   "OK", IDOK, 100, 75, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 75, 50, 14
END

/* About dialog template */
IDD_ABOUT DIALOGEX 0, 0, 250, 120
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SerialEcho"
FONT 9, "Microsoft YaHei UI"
BEGIN
    ICON            IDI_APP, -1, 14, 14, 20, 20
    LTEXT           "SerialEcho v1.0", -1, 44, 14, 190, 10
    LTEXT           "Serial Port Loopback Device Simulator", -1, 44, 28, 190, 10
    LTEXT           "Uses com0com virtual serial port driver", -1, 44, 42, 190, 10
    LTEXT           "Copyright (c) 2026", -1, 44, 60, 190, 10
    DEFPUSHBUTTON   "OK", IDOK, 95, 90, 60, 14
END
